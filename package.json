{
  "name": "screenrec",
  "version": "1.0.0",
  "private": true,
  "description": "Simple screen recorder for Debian-based Linux distributions with X11/Wayland auto-detection and MP4 export",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "node server.ts",
    "lint": "tsc --noEmit",
    "test": "npx --yes tsx --test src/utils/*.test.ts tests/*.test.ts",
    "build:deb": "npm run build && node scripts/build-deb.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "lucide-react": "^0.511.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.5.0",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
